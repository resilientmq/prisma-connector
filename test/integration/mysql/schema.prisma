generator client {
  provider = "prisma-client"
  output   = "../generated-mysql"
}

datasource db {
  provider = "mysql"
}

model ResilientMqInboxEvent {
  id String @id @default(cuid())
  namespace String
  serviceId String
  messageId String
  type String?
  payloadJson String @db.LongText
  routingKey String?
  propertiesJson String? @db.LongText
  status String
  attempt Int @default(0)
  instanceId String?
  fencingToken String?
  leaseExpiresAt DateTime? @db.DateTime(3)
  lastAttemptAt DateTime? @db.DateTime(3)
  completedAt DateTime? @db.DateTime(3)
  errorName String?
  errorMessage String? @db.Text
  errorStack String? @db.LongText
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  @@unique([namespace, serviceId, messageId])
  @@index([namespace, status, leaseExpiresAt])
  @@map("resilientmq_inbox_events")
}

model ResilientMqOutboxEvent {
  id String @id @default(cuid())
  namespace String
  messageId String
  type String?
  payloadJson String @db.LongText
  routingKey String?
  propertiesJson String? @db.LongText
  status String
  attempt Int @default(0)
  serviceId String?
  instanceId String?
  fencingToken String?
  leaseExpiresAt DateTime? @db.DateTime(3)
  nextAttemptAt DateTime? @db.DateTime(3)
  lastAttemptAt DateTime? @db.DateTime(3)
  publishedAt DateTime? @db.DateTime(3)
  errorName String?
  errorMessage String? @db.Text
  errorStack String? @db.LongText
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  @@unique([namespace, messageId])
  @@index([namespace, status, nextAttemptAt, leaseExpiresAt])
  @@map("resilientmq_outbox_events")
}
