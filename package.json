{
  "name": "@resilientmq/prisma-connector",
  "version": "0.1.1",
  "description": "Prisma persistence connector for resilient RabbitMQ inbox and outbox processing",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    },
    "./v8": {
      "types": "./dist/v8/index.d.ts",
      "import": "./dist/v8/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "resilientmq-prisma": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "prisma",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration:prepare": "prisma validate --config test/integration/prisma/prisma.config.ts && prisma generate --config test/integration/prisma/prisma.config.ts",
    "test:integration": "npm run test:integration:prepare && tsc -p tsconfig.integration.json --noEmit && vitest run --config vitest.integration.config.ts test/integration",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test:unit && npm run test:integration && npm run build && npm pack --dry-run",
    "prepublishOnly": "npm run check"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/resilientmq/prisma-connector.git"
  },
  "bugs": {
    "url": "https://github.com/resilientmq/prisma-connector/issues"
  },
  "homepage": "https://github.com/resilientmq/prisma-connector#readme",
  "keywords": [
    "resilientmq",
    "rabbitmq",
    "prisma",
    "outbox",
    "inbox",
    "resilience",
    "typescript"
  ],
  "author": "resilientmq",
  "license": "MIT",
  "peerDependencies": {
    "@prisma/client": ">=6.19 <8",
    "@prisma/orm-postgres": ">=8.0.0-0 <9",
    "@resilientmq/core": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    },
    "@prisma/orm-postgres": {
      "optional": true
    }
  },
  "devDependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@resilientmq/core": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^4.0.0",
    "better-sqlite3": "^12.8.0",
    "prisma": "^7.10.0",
    "typescript": "^6.0.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
